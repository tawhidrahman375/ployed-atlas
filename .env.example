# --- Core (needed to run anything) ---
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ledger / billing (Stripe webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Apollo / lead search ---
# Brave Search API. https://api-dashboard.search.brave.com/ — no free tier
# as of 2026, requires a card on file, $5/month credit (~1000 queries).
# Apollo uses ~8/run, well inside that.
BRAVE_SEARCH_API_KEY=

# Hunter.io — free tier is 25 email lookups/month. https://hunter.io/api-keys
# Apollo caps itself at 5 lookups/run to spread that across many days.
HUNTER_API_KEY=

# --- Echo / outreach ---
INSTANTLY_API_KEY=
# Deliberately left blank until you've actually created a campaign in
# Instantly and decided you're ready for it to start sending real emails.
# Leaving this unset is what keeps Echo from sending anything live.
INSTANTLY_CAMPAIGN_ID=

# --- Pixel / creative ---
# The `higgsfield` CLI handles its own auth (`higgsfield auth login`,
# stored under ~/.config/higgsfield/) — no env var needed here.
COMPOSIO_API_KEY=

# --- Pulse / analytics ---
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
GSC_SITE_URL=
GSC_CREDENTIALS_JSON=

# --- Vega / market intel ---
# No key needed for Reddit RSS or basic scraping.
# Product Hunt (optional, for launch monitoring):
PRODUCTHUNT_API_TOKEN=

# --- Dashboard (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
