# --- Core (needed to run anything) ---
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ledger / billing (Stripe webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Apollo / lead search ---
# Brave Search API. https://api-dashboard.search.brave.com/ — no free tier
# as of 2026, requires a card on file, $5/month credit (~1000 queries).
# Apollo uses ~8/run, well inside that.
BRAVE_SEARCH_API_KEY=

# Anymail Finder — LinkedIn-URL email lookup, only charges a credit on a
# genuine find (not_found/risky results are free). https://anymailfinder.com/pricing
ANYMAIL_FINDER_API_KEY=

# --- Echo / outreach ---
INSTANTLY_API_KEY=
# Deliberately left blank until you've actually created a campaign in
# Instantly and decided you're ready for it to start sending real emails.
# Leaving this unset is what keeps Echo from sending anything live.
INSTANTLY_CAMPAIGN_ID=

# --- Pixel / creative ---
# Pexels API — real stock photography for slideshow backgrounds (no AI-
# generated imagery). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=
COMPOSIO_API_KEY=

# --- Pulse / analytics ---
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
GSC_SITE_URL=
GSC_CREDENTIALS_JSON=

# --- Vega / market intel ---
# No key needed for Reddit RSS or basic scraping.
# Product Hunt (optional, for launch monitoring):
PRODUCTHUNT_API_TOKEN=

# --- Dashboard (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Dashboard on-demand revalidation ---
# Triggers an immediate dashboard refresh after each morning/evening block
# instead of waiting for its 5-minute ISR window. Same value must also be set
# as REVALIDATE_SECRET in dashboard/.env.local (local dev) and in the Vercel
# project's Production env vars (live) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
# Only needed if the dashboard isn't at the default Vercel URL in
# src/lib/revalidate.ts.
DASHBOARD_URL=
